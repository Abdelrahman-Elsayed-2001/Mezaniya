# Copy to mezaniya.env and change what you need. Environment variables override this file.

# Listen on every network card (other devices on the network can connect).
# Use 127.0.0.1 to allow this computer only.
MEZANIYA_HOST=0.0.0.0
MEZANIYA_PORT=8080
MEZANIYA_THREADS=8

# Default language (ar / en): the web app before a visitor picks one, the server manager,
# the log and manage.py. Each visitor can switch language from the page itself.
MEZANIYA_LANGUAGE=ar

# Anyone who can reach the server can register while this is true.
MEZANIYA_ALLOW_REGISTRATION=true

# How long a login lasts, in days.
MEZANIYA_SESSION_DAYS=30

# Lock a username (from one device) after this many wrong passwords, for this many seconds.
MEZANIYA_LOGIN_MAX_ATTEMPTS=5
MEZANIYA_LOGIN_LOCK_SECONDS=300

# Where everything is stored (database, secret key, backups, logs).
# MEZANIYA_DATA_DIR=C:\mezaniya-data
# MEZANIYA_DB_PATH=C:\mezaniya-data\mezaniya.db
# MEZANIYA_BACKUP_DIR=D:\backups\mezaniya
# MEZANIYA_LOG_DIR=C:\mezaniya-data\logs

# Automatic backups: one every N hours (0 = off), keep the newest K files.
MEZANIYA_BACKUP_INTERVAL_HOURS=24
MEZANIYA_BACKUP_KEEP=14

# Normally left empty: a key is generated once and saved in DATA_DIR\secret_key.
# MEZANIYA_SECRET_KEY=
